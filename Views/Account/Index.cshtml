@using CityMarketPOS.Models.ViewModels
@model IEnumerable<StaffListViewModel>
@{
    ViewData["Title"] = "Staff Management";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-users text-primary mr-2"></i> Staff Management
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Staff List</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="icon fas fa-check"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="card card-primary card-outline shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> All Employees
                </h3>
                <div class="card-tools">
                    <a asp-action="CreateUser" class="btn btn-light btn-sm">
                        <i class="fas fa-plus mr-1"></i> Add New Staff
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="accountTable" class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0">
                                    <i class="fas fa-user mr-1"></i> Full Name
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-at mr-1"></i> Username
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-user-tag mr-1"></i> Role
                                </th>
                                <th class="border-top-0 text-center" style="width: 150px;">
                                    <i class="fas fa-cogs mr-1"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@user.FullName</strong>
                                    </td>
                                    <td>
                                        <span class="badge badge-light text-muted">@user.UserName</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-@(user.Role == "Manager" ? "danger" : user.Role == "Inventory" ? "warning" : "info") px-3 py-2 font-weight-bold rounded-pill">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-info btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (user.Role != "Manager")
                                            {
                                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" class="d-inline">
                                                    <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @Model.Count() staff members
                </small>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#accountTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50, 100],
                "language": {
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i>",
                        "next": "<i class='fas fa-chevron-right'></i>"
                    }
                }
            });
        });
    </script>
}