@model CityMarketPOS.Models.GroundBalance
@{
    ViewData["Title"] = "Delete Ground Balance";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-trash text-danger"></i> Delete Ground Balance</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-header border-0 bg-white pt-3">
                <h3 class="card-title font-weight-bold">Confirm Deletion</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Warning:</strong> Are you sure you want to delete this Ground Balance record? This action cannot be undone.
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Batch No:</dt>
                    <dd class="col-sm-9">@Model.BatchNo</dd>

                    <dt class="col-sm-3">GB Date:</dt>
                    <dd class="col-sm-9">@Model.GBDate.ToString("dd-MM-yyyy")</dd>

                    <dt class="col-sm-3">Status:</dt>
                    <dd class="col-sm-9">@Model.Status</dd>

                    <dt class="col-sm-3">Remarks:</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Remark) ? "-" : Model.Remark)</dd>

                    <dt class="col-sm-3">Total Items:</dt>
                    <dd class="col-sm-9">@Model.GroundBalanceDetails.Count()</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="BatchNo" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </form>
            </div>
        </div>
    </div>
</section>
