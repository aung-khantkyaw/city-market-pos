@model IEnumerable<CityMarketPOS.Models.GroundBalance>
@{
    ViewData["Title"] = "Ground Balance";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-clipboard-check text-primary mr-2"></i> Ground Balance
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Ground Balance</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> GB History
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-light btn-sm" onclick="location.href='@Url.Action("Create")'">
                        <i class="fas fa-plus mr-1"></i> New GB Check
                    </button>
                </div>
            </div>
            <div class="card-body p-3">
                <form asp-action="Index" method="get" class="mb-3">
                    <div class="card bg-light">
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group mb-0">
                                        <label for="gbDate" class="small font-weight-bold">
                                            <i class="fas fa-calendar mr-1"></i> GB Date
                                        </label>
                                        <input type="date" id="gbDate" name="gbDate" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="form-group mb-0">
                                        <label for="status" class="small font-weight-bold">
                                            <i class="fas fa-flag mr-1"></i> Status
                                        </label>
                                        <select id="status" name="status" class="form-control form-control-sm">
                                            @if (ViewBag.StatusList != null)
                                            {
                                                @foreach (var item in ViewBag.StatusList as List<SelectListItem>)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group mb-0">
                                        <label>&nbsp;</label>
                                        <div class="btn-group w-100">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="fas fa-filter"></i> Filter
                                            </button>
                                            <a asp-action="Index" class="btn btn-secondary btn-sm">
                                                <i class="fas fa-times"></i> Clear
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="gbTable" class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0">
                                    <i class="fas fa-hashtag mr-1"></i> Batch No
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-calendar-alt mr-1"></i> GB Date
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-flag mr-1"></i> Status
                                </th>
                                <th class="border-top-0 text-center">
                                    <i class="fas fa-boxes mr-1"></i> Items
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-comment mr-1"></i> Remarks
                                </th>
                                <th class="border-top-0 text-center">
                                    <i class="fas fa-cogs mr-1"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge badge-primary px-3 py-2 font-weight-bold">@item.BatchNo</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-light text-muted">
                                                <i class="fas fa-calendar mr-1"></i> @item.GBDate.ToString("dd MMM yyyy")
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.Status == "Pending")
                                            {
                                                <span class="badge badge-warning px-3 py-2 text-dark rounded-pill">
                                                    <i class="fas fa-clock mr-1"></i> @item.Status
                                                </span>
                                            }
                                            else if (item.Status == "Completed")
                                            {
                                                <span class="badge badge-success px-3 py-2 rounded-pill">
                                                    <i class="fas fa-check-circle mr-1"></i> @item.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger px-3 py-2 rounded-pill">
                                                    @item.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-info px-3 py-2 font-weight-bold">@item.GroundBalanceDetails.Count()</span>
                                        </td>
                                        <td>
                                            <span class="text-muted small">@(string.IsNullOrWhiteSpace(item.Remark) ? "-" : item.Remark)</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-action="Details" asp-route-batchNo="@item.BatchNo" class="btn btn-info btn-sm" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-batchNo="@item.BatchNo" class="btn btn-warning btn-sm" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-batchNo="@item.BatchNo" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No Ground Balance records found.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @Model.Count() GB records
                </small>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(function () {
            // Only initialize DataTables if there's data
            @if (Model != null && Model.Any())
            {
                <text>
            $('#gbTable').DataTable({
                'paging': true,
                'lengthChange': true,
                'searching': true,
                'ordering': true,
                'info': true,
                'autoWidth': false,
                'pageLength': 10,
                'lengthMenu': [5, 10, 25, 50, 100],
                'language': {
                    'paginate': {
                        'previous': '<i class="fas fa-chevron-left"></i>',
                        'next': '<i class="fas fa-chevron-right"></i>'
                    }
                }
            });
                </text>
            }

            // Preserve selected values after postback
            @if (Context.Request.Query["gbDate"].Count > 0)
            {
                <text>$('#gbDate').val('@Context.Request.Query["gbDate"]');</text>
            }
            @if (Context.Request.Query["status"].Count > 0)
            {
                <text>$('#status').val('@Context.Request.Query["status"]');</text>
            }
        });
    </script>
}
