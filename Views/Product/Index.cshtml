@model IEnumerable<CityMarketPOS.Models.Product>
@{
    ViewData["Title"] = "Product";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-boxes text-primary mr-2"></i> Product Management
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Products</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> Product List
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-light btn-sm" onclick="openCreateModal()">
                        <i class="fas fa-plus mr-1"></i> Add Product
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="productTable" class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0">
                                    <i class="fas fa-box mr-1"></i> Name
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-folder mr-1"></i> Category
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-ruler mr-1"></i> UOM
                                </th>
                                <th class="border-top-0 text-center">
                                    <i class="fas fa-exclamation-triangle mr-1"></i> Min Stock Level
                                </th>
                                <th class="border-top-0 text-center">
                                    <i class="fas fa-cogs mr-1"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@item.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge badge-info">@item.Category?.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light text-muted">@item.UOM?.Name</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-warning px-3 py-2 font-weight-bold">@item.MinStockLevel</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-info btn-sm" onclick="openEditModal(@item.Id)" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @Model.Count() products
                </small>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="productModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["Success"] != null)
        {
             <text>
                 Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@TempData["Success"]',
                    timer: 3000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                 });
             </text>
        }

        $(document).ready(function() {
            // Only initialize DataTables if there's data
            @if (Model != null && Model.Any())
            {
                <text>
            $('#productTable').DataTable({
                'paging': true,
                'lengthChange': true,
                'searching': true,
                'ordering': true,
                'info': true,
                'autoWidth': false,
                'pageLength': 10,
                'lengthMenu': [5, 10, 25, 50, 100],
                'language': {
                    'paginate': {
                        'previous': '<i class="fas fa-chevron-left"></i>',
                        'next': '<i class="fas fa-chevron-right"></i>'
                    }
                }
            });
                </text>
            }
        });

        function openCreateModal() {
            $.get('@Url.Action("Create", "Product")', function (data) {
                $('#modalContent').html(data);
                $('#productModal').modal('show');
            });
        }

        function openEditModal(id) {
            $.get('@Url.Action("Edit", "Product")/' + id, function (data) {
                $('#modalContent').html(data);
                $('#productModal').modal('show');
            });
        }
    </script>
}