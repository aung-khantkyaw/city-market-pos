@{
    ViewData["Title"] = "Sales Reports";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-chart-line text-primary mr-2"></i> Sales Reports
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
                    <li class="breadcrumb-item active">Sales Reports</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Form -->
        <div class="card card-outline card-primary mb-3 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-filter mr-2"></i> Filter Sales
                </h3>
            </div>
            <div class="card-body p-3">
                <form asp-action="Index" method="get">
                    <div class="card bg-light">
                        <div class="card-body py-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="small font-weight-bold">
                                            <i class="fas fa-calendar-alt mr-1"></i> Start Date
                                        </label>
                                        <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate?.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="small font-weight-bold">
                                            <i class="fas fa-calendar-alt mr-1"></i> End Date
                                        </label>
                                        <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewBag.EndDate?.ToString("yyyy-MM-dd")" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="small font-weight-bold">
                                            <i class="fas fa-user mr-1"></i> Cashier
                                        </label>
                                        <select name="cashierId" class="form-control form-control-sm">
                                            <option value="">All Cashiers</option>
                                            @if (ViewBag.Cashiers != null)
                                            {
                                                foreach (var cashier in ViewBag.Cashiers)
                                                {
                                                    <option value="@cashier.CashierId" selected="@(ViewBag.CashierId == cashier.CashierId)">@cashier.CashierName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group mb-0">
                                        <label class="small font-weight-bold">
                                            <i class="fas fa-store mr-1"></i> Counter
                                        </label>
                                        <select name="counterId" class="form-control form-control-sm">
                                            <option value="">All Counters</option>
                                            @if (ViewBag.Counters != null)
                                            {
                                                foreach (var counter in ViewBag.Counters)
                                                {
                                                    <option value="@counter.Id" selected="@(ViewBag.CounterId == counter.Id)">@counter.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="fas fa-search mr-1"></i> Apply Filters
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-times mr-1"></i> Clear Filters
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Statistics -->
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@ViewBag.TotalSales</h3>
                        <p>Total Sales</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@ViewBag.TotalAmount.ToString("F2")</h3>
                        <p>Total Revenue ($)</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewBag.TotalItems</h3>
                        <p>Total Items Sold</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@ViewBag.TotalTax.ToString("F2")</h3>
                        <p>Total Tax (5%)</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-percentage"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sales Table -->
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> Sales Details
                </h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    @if (ViewBag.Sales != null && ((List<CityMarketPOS.Models.Sale>)ViewBag.Sales).Any())
                    {
                        <table id="salesTable" class="table table-hover table-striped align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-top-0">
                                        <i class="fas fa-hashtag mr-1"></i> Sale #
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-calendar-alt mr-1"></i> Date/Time
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-user mr-1"></i> Cashier
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-store mr-1"></i> Counter
                                    </th>
                                    <th class="border-top-0 text-center">
                                        <i class="fas fa-boxes mr-1"></i> Items
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-dollar-sign mr-1"></i> Subtotal
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-percentage mr-1"></i> Tax
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-tag mr-1"></i> Discount
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-dollar-sign mr-1"></i> Total
                                    </th>
                                    <th class="border-top-0">
                                        <i class="fas fa-credit-card mr-1"></i> Payment
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in ViewBag.Sales as List<CityMarketPOS.Models.Sale>)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge badge-primary px-3 py-2 font-weight-bold">@sale.SaleNumber</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-light text-muted">
                                                <i class="fas fa-calendar mr-1"></i> @sale.SaleDate.ToString("dd MMM yyyy HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-dark">@sale.CashierName</span>
                                        </td>
                                        <td>
                                            <span class="badge badge-secondary">@sale.POSSession?.Counter?.Name</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-info px-3 py-2 font-weight-bold">@sale.Details.Sum(d => d.Quantity)</span>
                                        </td>
                                        <td>
                                            <span class="text-muted">@sale.Subtotal.ToString("F2")</span>
                                        </td>
                                        <td>
                                            <span class="text-danger">@sale.Tax.ToString("F2")</span>
                                        </td>
                                        <td>
                                            <span class="text-warning">@sale.Discount.ToString("F2")</span>
                                        </td>
                                        <td>
                                            <strong class="text-success">@sale.GrandTotal.ToString("F2")</strong>
                                        </td>
                                        <td>
                                            <span class="badge badge-success">@sale.PaymentMethod</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <td colspan="6" class="text-right">
                                        <strong>Grand Total:</strong>
                                    </td>
                                    <td>
                                        <strong class="text-danger">@ViewBag.TotalTax.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        <strong class="text-warning">@ViewBag.TotalDiscount.ToString("F2")</strong>
                                    </td>
                                    <td colspan="3">
                                        <strong class="text-success">@ViewBag.TotalAmount.ToString("F2")</strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No sales found for the selected criteria.</p>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @((ViewBag.Sales as List<CityMarketPOS.Models.Sale>)?.Count() ?? 0) sales records
                </small>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#salesTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50, 100],
                "language": {
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i>",
                        "next": "<i class='fas fa-chevron-right'></i>"
                    }
                }
            });
        });
    </script>
}
