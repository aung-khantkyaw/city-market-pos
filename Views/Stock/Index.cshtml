@model List<CityMarketPOS.Models.ViewModels.StockGroupViewModel>
@{
    ViewData["Title"] = "Stock Tracking";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h1>
                    <i class="fas fa-boxes mr-2 text-primary"></i> Stock Tracking
                </h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Card -->
        <div class="card card-outline card-primary shadow-sm mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-filter mr-1"></i> Filter Stock
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Search</label>
                            <input type="text" name="search" class="form-control" value="@ViewBag.Search" placeholder="Product name or item code..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Category</label>
                            <select name="categoryId" class="form-control">
                                <option value="">All Categories</option>
                                @if (ViewBag.Categories != null)
                                {
                                    @foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div class="custom-control custom-checkbox mt-2">
                                <input type="checkbox" name="lowStock" class="custom-control-input" id="lowStock" value="true" @(ViewBag.LowStock ? "checked" : "") />
                                <label class="custom-control-label" for="lowStock">Low Stock Only</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <div class="custom-control custom-checkbox mt-2">
                                <input type="checkbox" name="expiringSoon" class="custom-control-input" id="expiringSoon" value="true" @(ViewBag.ExpiringSoon ? "checked" : "") />
                                <label class="custom-control-label" for="expiringSoon">Expiring Soon</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fas fa-search mr-1"></i> Filter
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Stock Accordion -->
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-boxes mr-2"></i> Stock by Purchase Order
                </h3>
                <div class="card-tools">
                    <span class="badge badge-light">@Model.Count Purchase Orders</span>
                </div>
            </div>
            <div class="card-body p-3">
                <div id="accordion">
                    @if (Model != null && Model.Count > 0)
                    {
                        int poIndex = 0;
                        @foreach (var poGroup in Model)
                        {
                            poIndex++;
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-header bg-light py-2">
                                    <h5 class="mb-0">
                                        <button class="btn btn-link w-100 text-left text-decoration-none p-2" data-toggle="collapse" data-target="#collapse-@poIndex">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="d-flex align-items-center">
                                                    <div class="mr-3">
                                                        <span class="badge badge-primary px-3 py-2 font-weight-bold">@poGroup.PONumber</span>
                                                    </div>
                                                    <div>
                                                        <div class="font-weight-bold text-dark">@poGroup.Supplier</div>
                                                        <small class="text-muted">
                                                            <i class="fas fa-calendar-alt mr-1"></i> @poGroup.OrderDate.ToString("dd MMM yyyy")
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <span class="badge badge-info mr-2">@poGroup.Details.Count Items</span>
                                                    <i class="fas fa-chevron-down text-muted"></i>
                                                </div>
                                            </div>
                                        </button>
                                    </h5>
                                </div>
                                <div id="collapse-@poIndex" class="collapse @(poIndex == 1 ? "show" : "")" data-parent="#accordion">
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-hover table-striped align-middle mb-0">
                                                <thead class="bg-light">
                                                    <tr>
                                                        <th class="border-top-0">Item Code</th>
                                                        <th class="border-top-0">Product Name</th>
                                                        <th class="border-top-0">Category</th>
                                                        <th class="border-top-0 text-center">Received</th>
                                                        <th class="border-top-0 text-center">Stock Qty</th>
                                                        <th class="border-top-0 text-center">Current Stock</th>
                                                        <th class="border-top-0 text-center">Min Level</th>
                                                        <th class="border-top-0">Purchase Price</th>
                                                        <th class="border-top-0">Selling Price</th>
                                                        <th class="border-top-0">Expiry Date</th>
                                                        <th class="border-top-0">GRN Number</th>
                                                        <th class="border-top-0 text-center">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in poGroup.Details)
                                                    {
                                                        if (item != null && item.Product != null)
                                                        {
                                                            int? daysUntilExpiry = null;
                                                            bool isExpired = false;

                                                            if (item.ExpiryDate.HasValue)
                                                            {
                                                                daysUntilExpiry = (item.ExpiryDate.Value.Date - DateTime.Now.Date).Days;
                                                                isExpired = daysUntilExpiry < 0;
                                                            }

                                                            string trClass = "";
                                                            if (isExpired)
                                                            {
                                                                trClass = "table-danger"; 
                                                            }
                                                            else if (item.Product.MinStockLevel > 0 && item.CurrentStockQuantity <= item.Product.MinStockLevel)
                                                            {
                                                                trClass = "table-warning bg-warning-light"; 
                                                            }

                                                            <tr class="@trClass">
                                                                <td><span class="badge badge-secondary">@item.ItemCode</span></td>
                                                                <td>
                                                                    <strong>@item.Product.Name</strong>
                                                                </td>
                                                                <td><span class="badge badge-light text-muted">@item.Product.Category?.Name</span></td>
                                                                <td class="text-center font-weight-bold">@item.ReceivedQuantity</td>
                                                                <td class="text-center">@item.StockQuantity</td>
                                                                <td class="text-center">
                                                                    <span class="badge @(item.Product.MinStockLevel > 0 && item.CurrentStockQuantity <= item.Product.MinStockLevel ? "badge-danger" : "badge-success") px-3 py-2">
                                                                        @item.CurrentStockQuantity
                                                                    </span>
                                                                </td>
                                                                <td class="text-center text-muted">@(item.Product.MinStockLevel > 0 ? item.Product.MinStockLevel.ToString() : "N/A")</td>
                                                                <td class="text-success font-weight-bold">@(item.PurchasePrice > 0 ? item.PurchasePrice.ToString("F2") : "N/A")</td>
                                                                <td class="text-primary font-weight-bold">@(item.SellingPrice > 0 ? item.SellingPrice.ToString("F2") : "N/A")</td>

                                                                <!-- ပြင်ဆင်ထားသော Expire Date TD -->
                                                                <td>
                                                                    @if (item.ExpiryDate.HasValue)
                                                                    {
                                                                        string badgeClass = "badge-success";
                                                                        if (daysUntilExpiry <= 7)
                                                                        {
                                                                            badgeClass = "badge-danger";
                                                                        }
                                                                        else if (daysUntilExpiry <= 30)
                                                                        {
                                                                            badgeClass = "badge-warning";
                                                                        }

                                                                        <span class="badge @badgeClass">
                                                                            @item.ExpiryDate.Value.ToString("dd MMM yyyy")
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted small">N/A</span>
                                                                    }
                                                                </td>

                                                                <td><span class="badge badge-info">@item.GRN?.GRNNumber</span></td>
                                                                <td class="text-center">
                                                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary shadow-sm">
                                                                        <i class="fas fa-eye"></i>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-body text-center py-5">
                            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No stock records found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Ensure only one accordion item is open at a time
        $('.collapse').on('show.bs.collapse', function () {
            $(this).closest('#accordion').find('.collapse.show').not(this).collapse('hide');
        });
    </script>
}
