@model IEnumerable<CityMarketPOS.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-truck text-primary mr-2"></i> Supplier Management
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Suppliers</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary card-outline shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> Supplier List
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-light btn-sm" onclick="openCreateModal()">
                        <i class="fas fa-plus mr-1"></i> Add Supplier
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="supplierTable" class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0">
                                    <i class="fas fa-building mr-1"></i> Name
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-user mr-1"></i> Contact Person
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-phone mr-1"></i> Phone
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-envelope mr-1"></i> Email
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-boxes mr-1"></i> Supplied Products
                                </th>
                                <th class="border-top-0 text-center" style="width: 150px;">
                                    <i class="fas fa-cogs mr-1"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@item.Name</strong>
                                    </td>
                                    <td>
                                        <span class="text-muted">@item.ContactPerson</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light text-muted">
                                            <i class="fas fa-phone-alt mr-1"></i> @item.Phone
                                        </span>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-primary">
                                            <i class="fas fa-envelope mr-1"></i> @item.Email
                                        </a>
                                    </td>
                                    <td>
                                        @if (item.Products != null && item.Products.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var prod in item.Products)
                                                {
                                                    <span class="badge badge-info">@prod.Name</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="fas fa-minus-circle mr-1"></i> No products
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-info btn-sm" onclick="openEditModal(@item.Id)" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this supplier? This will also delete all related Purchase Orders and GRNs.');" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @Model.Count() suppliers
                </small>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="supplierModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        @if (TempData["Success"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["Success"]',
                        timer: 3000,
                        showConfirmButton: false,
                        toast: true,
                        position: 'top-end'
                    });
                </text>
        }

        $(document).ready(function() {
            $('#supplierTable').DataTable({
                "paging": true,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": false,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i>",
                        "next": "<i class='fas fa-chevron-right'></i>"
                    }
                },
                "dom": "<'row'<'col-sm-12'tr>>" +
                      "<'row'<'col-sm-12 text-center'p>>"
            });
        });

        function openCreateModal() {
            $.get('@Url.Action("Create", "Supplier")', function (data) {
                $('#modalContent').html(data);
                $('#supplierModal').modal('show');
            });
        }

        function openEditModal(id) {
            $.get('@Url.Action("Edit", "Supplier")/' + id, function (data) {
                $('#modalContent').html(data);
                $('#supplierModal').modal('show');
            });
        }
    </script>
}