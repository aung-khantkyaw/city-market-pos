@model IEnumerable<CityMarketPOS.Models.UOM>
@{
    ViewData["Title"] = "UOMs";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="display-6 h3">
                    <i class="fas fa-balance-scale text-primary mr-2"></i> Unit of Measurement (UOM)
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">UOM</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list mr-2"></i> UOM List
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-light btn-sm" data-toggle="modal" data-target="#createUomModal">
                        <i class="fas fa-plus mr-1"></i> Add UOM
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table id="uomTable" class="table table-hover table-striped align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0">
                                    <i class="fas fa-font mr-1"></i> Full Name
                                </th>
                                <th class="border-top-0">
                                    <i class="fas fa-tag mr-1"></i> Short Name
                                </th>
                                <th class="border-top-0 text-center" style="width: 150px;">
                                    <i class="fas fa-cogs mr-1"></i> Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong class="text-dark">@item.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary px-3 py-2 font-weight-bold">@item.ShortName</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button type="button"
                                                    class="btn btn-info btn-sm edit-uom-btn"
                                                    data-toggle="modal"
                                                    data-target="#editUomModal"
                                                    data-id="@item.Id"
                                                    data-name="@item.Name"
                                                    data-shortname="@item.ShortName"
                                                    title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </button>

                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this UOM?');" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1"></i> Total: @Model.Count() UOMs
                </small>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="createUomModal" tabindex="-1" role="dialog" aria-labelledby="createUomModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createUomModalLabel"><i class="fas fa-plus mr-2"></i> Add New UOM</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="Create" method="post" id="createUomForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label for="createName">Unit Name</label>
                        <input type="text" id="createName" name="Name" class="form-control" placeholder="e.g. Pieces / Kilogram" required />
                    </div>
                    <div class="form-group">
                        <label for="createShortName">Short Name</label>
                        <input type="text" id="createShortName" name="ShortName" class="form-control" placeholder="e.g. PCS / KG" required />
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSave" class="btn btn-primary" disabled>Save UOM</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUomModal" tabindex="-1" role="dialog" aria-labelledby="editUomModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="editUomModalLabel"><i class="fas fa-edit mr-2"></i> Edit UOM</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="editUomForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="modalUomId" name="Id" />

                    <div class="form-group">
                        <label for="modalUomName">Unit Name</label>
                        <input type="text" id="modalUomName" name="Name" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="modalUomShortName">Short Name</label>
                        <input type="text" id="modalUomShortName" name="ShortName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer justify-content-between">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnUpdate" class="btn btn-info" disabled>Update UOM</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (TempData["Success"] != null)
        {
                     <text>
                                 Swal.fire({
                                    icon: 'success',
                                    title: 'Successful',
                                    text: '@TempData["Success"]',
                                    timer: 3000,
                                    showConfirmButton: false
                                 });
                     </text>
        }

        $(document).ready(function () {
            $('#uomTable').DataTable({
                "paging": true,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": false,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i>",
                        "next": "<i class='fas fa-chevron-right'></i>"
                    }
                },
                "dom": "<'row'<'col-sm-12'tr>>" +
                      "<'row'<'col-sm-12 text-center'p>>"
            });

            // --- Create Logic ---
            $('#createName, #createShortName').on('input', function () {
                var name = $('#createName').val().trim();
                var shortName = $('#createShortName').val().trim();
                if (name !== "" && shortName !== "") {
                    $('#btnSave').removeAttr('disabled');
                } else {
                    $('#btnSave').attr('disabled', 'disabled');
                }
            });

            // Modal ပိတ်လိုက်ရင် Form ထဲကစာတွေကို Reset လုပ်မယ်
            $('#createUomModal').on('hidden.bs.modal', function () {
                $('#createUomForm')[0].reset();
                $('#btnSave').attr('disabled', 'disabled');
            });

            // --- Edit Logic ---
            $('.edit-uom-btn').on('click', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var shortName = $(this).data('shortname');

                $('#modalUomId').val(id);
                $('#modalUomName').val(name);
                $('#modalUomShortName').val(shortName);

                $('#editUomForm').attr('action', '/UOM/Edit/' + id);

                validateEditForm();
            });

            $('#modalUomName, #modalUomShortName').on('input', function () {
                validateEditForm();
            });

            function validateEditForm() {
                var name = $('#modalUomName').val().trim();
                var shortName = $('#modalUomShortName').val().trim();

                if (name !== "" && shortName !== "") {
                    $('#btnUpdate').removeAttr('disabled');
                } else {
                    $('#btnUpdate').attr('disabled', 'disabled');
                }
            }
        });
    </script>
}